# ============================================================================
#  Bootsbaza Instagram-бот — переменные окружения
#  Скопируйте в .env и заполните. Ни один ключ НЕ коммитим.
# ============================================================================

# --- Claude (Anthropic) ------------------------------------------------------
# Ключ API: https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Сайт (источник каталога) -----------------------------------------------
# Публичный адрес сайта. Бот берёт товары через ${SITE_URL}/api/catalog.
SITE_URL=https://bootsbaza.com

# --- Telegram (уведомления в группу менеджеров) ------------------------------
# Тот же бот/группа, что и на сайте, или отдельный.
# Токен от @BotFather, chat_id группы (обычно отрицательное число).
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-1001234567890

# --- Instagram / Meta --------------------------------------------------------
# Токен доступа страницы/аккаунта Instagram (Instagram Login или Facebook Login
# for Business). Для отправки сообщений через Send API.
IG_ACCESS_TOKEN=EAAG...

# Секретное слово для верификации вебхука (придумайте сами, впишите то же
# значение в настройках вебхука в Meta App Dashboard).
IG_VERIFY_TOKEN=bootsbaza-verify-2026

# App Secret приложения Meta — для проверки подписи X-Hub-Signature-256.
# Необязательно, но настоятельно рекомендуется. Если пусто — проверка пропускается.
META_APP_SECRET=

# База Graph API. По умолчанию — Instagram Login.
#   Instagram Login:            https://graph.instagram.com/v21.0
#   Facebook Login for Business: https://graph.facebook.com/v21.0
GRAPH_API_BASE=https://graph.instagram.com/v21.0

# --- Сервер ------------------------------------------------------------------
PORT=8080

# ---------------------------------------------------------------------------
# Bootsbaza — переменные окружения. Скопируйте в .env.local и заполните.
# .env.local в git НЕ коммитится.
# ---------------------------------------------------------------------------

# ID Google-таблицы (по умолчанию уже задан в lib/config.ts).
# SPREADSHEET_ID=1JRAYTZNtYiNgJE6lT1DPpG9eeXP2PUxQcqG-0Hyg0JE

# ОСНОВНОЙ ПУТЬ: API-ключ Google Sheets API (таблица публичная — этого достаточно
# для чтения значений и формул =IMAGE()).
GOOGLE_API_KEY=

# ОПЦИОНАЛЬНО: сервис-аккаунт (JSON или base64) — нужен только если фото
# вставлены как объекты и требуется экспорт .xlsx через Drive API.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Наценка: обувь — фикс. надбавка (грн), экипировка — процент. Можно менять здесь.
# FOOTWEAR_MARKUP_FIXED=500
# GEAR_MARKUP_PERCENT=0.40
# PRICE_ROUND_TO=10

# Кэш (в секундах): период фонового обновления и жёсткий предел.
# CACHE_TTL_SECONDS=300
# CACHE_HARD_TTL_SECONDS=3600

# Токен для ручного сброса кэша через POST /api/revalidate
# REVALIDATE_TOKEN=

# --- Приём заказов в Telegram ---
# Токен бота от @BotFather и chat id получателя (ваш id или id группы).
# Если не заданы — заказы просто логируются в консоль сервера.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Нова Пошта (город/отделение при оформлении) ---
# API-ключ Нової Пошти. Без него поля города/отделения станут ручным вводом.
# NOVAPOSHTA_API_KEY=

# --- SEO / базовый URL сайта (для OpenGraph и sitemap) ---
# NEXT_PUBLIC_SITE_URL=https://bootsbaza.com

# --- Аналитика (подключается при наличии ID) ---
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_FB_PIXEL_ID=1234567890

# --- Дублирование заказов в Google-таблицу ---
# Отдельная таблица для заказов; сервис-аккаунт (GOOGLE_SERVICE_ACCOUNT_JSON выше)
# должен иметь к ней доступ на редактирование. Лист по умолчанию — «Замовлення».
# ORDERS_SPREADSHEET_ID=
# ORDERS_SHEET_NAME=Замовлення

# --- Ночная автопересборка (Vercel Cron → Deploy Hook) ---
# URL деплой-хука (Vercel → Settings → Git → Deploy Hooks) и секрет для защиты
# крон-роута /api/rebuild (Vercel Cron сам шлёт его как Bearer-токен).
# DEPLOY_HOOK_URL=
# CRON_SECRET=
